pipeline {
    agent any

    options { skipDefaultCheckout() }

    stages {
        stage('Get Code') {
            steps {
                git 'https://github.com/miguelferrercrespo/helloworld.git'
                echo "WORKSPACE: ${env.WORKSPACE}"
                bat 'dir'
                stash name: 'code', includes: '**/*'
            }
        }

        stage('Build') {
            steps {
                echo 'Eyyy, esto es Python. No hay que compilar nada!!!'
            }
        }

        stage('Tests') {
            parallel {
                stage('Unit') {
                    // Se queda en el agente principal (el que pille agent any)
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            unstash 'code'
                            bat '''
                                set PYTHONPATH=%WORKSPACE%
                                python -m pytest --junitxml=result-unit.xml test\\unit
                            '''
                            stash name: 'unit-res', includes: 'result-unit.xml'
                        }
                    }
                }

                stage('Rest') {
                    agent { label 'agent3' }
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            unstash 'code'
                            bat '''
                                set FLASK_APP=app\\api.py
                                start "" /B flask run

                                ping 127.0.0.1 -n 5 >NUL

                                start "" /B java -jar C:\\Users\\migue\\Unir_Devops\\wiremock\\wiremock-jre8-standalone-2.28.0.jar --port 9090 --root-dir test\\wiremock

                                ping 127.0.0.1 -n 10 >NUL

                                set PYTHONPATH=%WORKSPACE%
                                python -m pytest --junitxml=result-rest.xml test\\rest
                            '''
                            stash name: 'rest-res', includes: 'result-rest.xml'
                        }
                    }
                }
            }
        }

        stage('Results') {
            steps {
                unstash 'unit-res'
                unstash 'rest-res'
                junit 'result*.xml'
            }
        }
    }
}
